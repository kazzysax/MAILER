# ===== Mailer Platform — copy to .env and fill in =====

# --- Server ---
PORT=8080
# Public URL of this server (used in links). e.g. https://mailer.yourdomain.com
BASE_URL=http://localhost:8080
# Long random string — encrypts user email credentials + signs sessions. NEVER change after launch.
SERVER_SECRET=change_me_to_a_long_random_string

# --- Database (required) — Postgres connection string ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- AI (required) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- The ONE official Mailer Telegram bot (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your bot's username without @ — used to build the magic link t.me/<username>?start=CODE
TELEGRAM_BOT_USERNAME=MailerBot

# --- "Sign in with Google" (optional — leave blank to hide the button) ---
# OAuth 2.0 Client ID (Web application) from console.cloud.google.com/apis/credentials.
# Add this app's URL(s) under "Authorized JavaScript origins" (no path, no trailing slash).
GOOGLE_CLIENT_ID=

# --- WhatsApp via Twilio (optional — leave blank to disable) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Behaviour ---
POLL_SECONDS=60
PUSH_NORMAL=true
DIGEST_HOUR=8

# --- Optional: voice-note replies (WhatsApp) — transcription via OpenAI Whisper ---
OPENAI_API_KEY=

# --- Optional: the shared "forward anything to Mailer" inbox ---
# Any email forwarded here by a signed-up user gets processed to their chat.
FORWARD_MAIL_USER=
FORWARD_MAIL_PASSWORD=
FORWARD_IMAP_HOST=imap.gmail.com
FORWARD_IMAP_PORT=993

# --- Silence catcher: nudge after this many days without a reply ---
NUDGE_DAYS=3

# --- Scam-risk flagging on incoming mail (never blocks, only flags) ---
SCAM_CHECK_ENABLED=true

# --- Onchain status logging (Monad mainnet — no testnet) ---
# Mailer's own server wallet signs+submits every log tx itself (no user wallet
# popup). Feature no-ops safely (skipped, logged to console) until both
# MONAD_WALLET_KEY and MAILER_LOG_CONTRACT_ADDRESS are set.
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143
# Private key of Mailer's server wallet — SECRET, pays gas + signs every log tx.
# No existing wallet? Run: npm run generate-wallet
MONAD_WALLET_KEY=
# Fill in after deploying contracts/MailerLog.sol: npm run deploy-contract
MAILER_LOG_CONTRACT_ADDRESS=
MONAD_EXPLORER_URL=https://monadscan.com
